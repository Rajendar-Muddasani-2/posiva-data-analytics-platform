# POSIVA Analytics Platform - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================================================
# PROJECT SETTINGS
# ============================================================================
PROJECT_NAME=POSIVA Analytics Platform
ENVIRONMENT=development  # development, staging, production
DEBUG=True

# ============================================================================
# DATA PATHS
# ============================================================================
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
DATA_FEATURES_PATH=./data/features
REPORTS_PATH=./reports

# ============================================================================
# DATABASE (Optional)
# ============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/posiva
# MONGO_URL=mongodb://localhost:27017/posiva
# REDIS_URL=redis://localhost:6379

# ============================================================================
# AI/ML MODEL SETTINGS
# ============================================================================
MODEL_PATH=./models
MLFLOW_TRACKING_URI=./models/mlruns
# WANDB_API_KEY=your_wandb_key_here
# WANDB_PROJECT=posiva-analytics

# ============================================================================
# AI API KEYS (For NLG features)
# ============================================================================
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ============================================================================
# NOTIFICATION SERVICES
# ============================================================================
# Email Settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=posiva-analytics@yourcompany.com
# EMAIL_TO=team@yourcompany.com

# Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_CHANNEL=#posiva-analytics

# ============================================================================
# DASHBOARD SETTINGS
# ============================================================================
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# ============================================================================
# AIRFLOW (Optional)
# ============================================================================
# AIRFLOW_HOME=./airflow
# AIRFLOW__CORE__DAGS_FOLDER=./src/pipeline/airflow_dags
# AIRFLOW__CORE__EXECUTOR=LocalExecutor

# ============================================================================
# DATA QUALITY
# ============================================================================
DATA_QUALITY_THRESHOLD=0.95
OUTLIER_DETECTION_THRESHOLD=3  # Z-score threshold

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/posiva.log

# ============================================================================
# PERFORMANCE
# ============================================================================
N_JOBS=-1  # Number of CPU cores to use (-1 = all)
CACHE_SIZE_MB=1024
BATCH_SIZE=10000

# ============================================================================
# SECURITY (Production)
# ============================================================================
# SECRET_KEY=your-secret-key-here
# ALLOWED_HOSTS=localhost,127.0.0.1
